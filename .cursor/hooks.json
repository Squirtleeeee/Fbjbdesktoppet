{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "node .cursor/hooks/pet-hook.cjs sessionStart" }
    ],
    "beforeSubmitPrompt": [
      { "command": "node .cursor/hooks/pet-hook.cjs beforeSubmitPrompt" }
    ],
    "postToolUse": [
      { "command": "node .cursor/hooks/pet-hook.cjs postToolUse" }
    ],
    "stop": [
      { "command": "node .cursor/hooks/pet-hook.cjs stop" }
    ]
  }
}
